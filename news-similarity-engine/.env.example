# ==============================================================================
# Persian News Similarity Engine - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

# Model and Similarity Thresholds
EMBEDDING_MODEL_NAME=BAAI/bge-m3
SIMILARITY_HIGH_THRESHOLD=0.75
SIMILARITY_MODERATE_THRESHOLD=0.50

# HTTP Scraper Configuration
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
REQUEST_TIMEOUT=12.0
MIN_POST_LENGTH=35

# Platform Endpoints
EITAA_BASE_URL=https://eitaa.com
BALE_BASE_URL=https://ble.ir

# Default Channel Handles
DEFAULT_EITAA_CHANNEL=farsna
DEFAULT_BALE_CHANNEL=iribnews
